{
    "name": "torchtitan",
    "dockerFile": "Dockerfile",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ],
            "settings": {
                "python.pythonPath": "/usr/local/bin/python",
                "terminal.integrated.shell.linux": "/bin/zsh"
            }
        }
    },
	"containerEnv": {
		"HF_HOME": "/hf_home"
	},
	"runArgs": [
		"--gpus=all",
		"--shm-size=16G",
        "--cap-add=CAP_SYS_ADMIN",
        "-v", "/mnt/local_nvme/alex:/hf_home"
	]
}